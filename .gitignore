install_manifest.txt

# Visual Studio 相关文件（如果还有残留）
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.sdf
*.opensdf

# 编译产物和临时文件
*.exe
*.dll
*.lib
*.obj
*.pdb
*.ilk
*.log
*.tlog
*.tmp
*.ipch
*.db
*.dmp

# 其他临时文件
*~
.DS_Store
Thumbs.db

# 输入输出文件
input/
output/
